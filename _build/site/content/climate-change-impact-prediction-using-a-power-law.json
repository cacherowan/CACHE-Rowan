"type":"inlineCode","value":"Eref","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"oHd8WVPBNz"},{"type":"text","value":", and ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"g4bhpzea02"},{"type":"inlineCode","value":"GWPref","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"hAlNIFnzzb"},{"type":"text","value":" are the reference case, the highest-throughput point that everything is scaled against.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"sJnPCouDSQ"}],"key":"RXEZGZdNvw"}],"identifier":"uqnxnddiqvht","label":"UqNXnDDIqvht","html_id":"uqnxnddiqvht","key":"qjuqaGQneX"},{"type":"block","kind":"notebook-code","data":{"id":"bMq-9ziCqxPm"},"children":[{"type":"code","lang":"python","executable":true,"value":"GWPact = np.array([\n    8.84E+02,\n    1.52E+02,\n    1.29E+02,\n    1.27E+02,\n    1.18E+00,\n    3.69E+02,\n    1.95E+03\n])\n\nParam = np.array([\n    [0.00104,      1.47E+02],\n    [0.01,         1.00E+01],\n    [0.02,         8.33E+00],\n    [0.04,         1.57E+01],\n    [0.001079137,  5.25E+00],\n    [0.307246377,  1.60E+03],\n    [1.645410628,  8.47E+03]\n])\n\nFref = 1.645410628\nEref = 8.47E+03\nGWPref = 1.95E+03","identifier":"bmq-9zicqxpm-code","enumerator":"2","html_id":"bmq-9zicqxpm-code","key":"ZkD1jXjUgh"},{"type":"outputs","id":"bTwLd-z0acjsjKdgfVnLz","children":[],"identifier":"bmq-9zicqxpm-outputs","html_id":"bmq-9zicqxpm-outputs","key":"HRknYAECXX"}],"identifier":"bmq-9zicqxpm","label":"bMq-9ziCqxPm","html_id":"bmq-9zicqxpm","key":"NPA2Fz2DS2"},{"type":"block","kind":"notebook-content","data":{"id":"3hDh_g2NqzgR"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Determine α and β","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EOkNXzxwUX"}],"identifier":"id-3-determine-and","label":"3. Determine α and β","html_id":"id-3-determine-and","implicit":true,"key":"r8Ff3Jb4iC"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Normalises F and E against the reference case, then searches for the α and β that make the predicted GWP match the actual GWP as closely as possible","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"rUv9usdww5"}],"key":"CZvUTFGfgn"}],"identifier":"3hdh_g2nqzgr","label":"3hDh_g2NqzgR","html_id":"id-3hdh-g2nqzgr","key":"YErvj2IrZl"},{"type":"block","kind":"notebook-code","data":{"id":"8tvUKzgxq1Eo"},"children":[{"type":"code","lang":"python","executable":true,"value":"X1 = Param[:, 0] / Fref\nX2 = Param[:, 1] / Eref\n\ndef residuals(k):\n    GWPpred = (X1**k[0] * X2**k[1]) * GWPref\n    return np.sum((np.log(GWPact) - np.log(GWPpred))**2)\n\nx0 = [0.07, 0.49]\nres = minimize(residuals, x0, method='Nelder-Mead')\nalpha, beta = res.x","identifier":"8tvukzgxq1eo-code","enumerator":"3","html_id":"id-8tvukzgxq1eo-code","key":"dzzXw7nKBk"},{"type":"outputs","id":"mgJ1XRF2MQpd02wXrnazo","children":[],"identifier":"8tvukzgxq1eo-outputs","html_id":"id-8tvukzgxq1eo-outputs","key":"w4577YkNHe"}],"identifier":"8tvukzgxq1eo","label":"8tvUKzgxq1Eo","html_id":"id-8tvukzgxq1eo","key":"bd5FlST9FB"},{"type":"block","kind":"notebook-content","data":{"id":"KdQNblj0q2wj"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Show the results","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"viPXvAnCfU"}],"identifier":"show-the-results","label":"Show the results","html_id":"show-the-results","implicit":true,"key":"IB5IliJHij"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Prints the fitted α and β, and the R² score showing how well the equation matches the actual GWP (1.0 is a perfect fit)","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"c5p9nR35yX"}],"key":"n6CYUzNJNf"}],"identifier":"kdqnblj0q2wj","label":"KdQNblj0q2wj","html_id":"kdqnblj0q2wj","key":"JtcYwpWT6v"},{"type":"block","kind":"notebook-code","data":{"id":"Hj2ytjC5q5TG"},"children":[{"type":"code","lang":"python","executable":true,"value":"GWPpred = (X1**alpha * X2**beta) * GWPref\n\nss_res = np.sum((GWPact - GWPpred)**2)\nss_tot = np.sum((GWPact - np.mean(GWPact))**2)\nr2 = 1 - ss_res / ss_tot\n\nprint(\"alpha =\", round(alpha, 4))\nprint(\"beta  =\", round(beta, 4))\nprint(\"R2 score    =\", round(r2, 4))","identifier":"hj2ytjc5q5tg-code","enumerator":"4","html_id":"hj2ytjc5q5tg-code","key":"ufOfZh8rnk"},{"type":"outputs","id":"Xc__y-PB6sEKG0DSVsf2Z","children":[],"identifier":"hj2ytjc5q5tg-outputs","html_id":"hj2ytjc5q5tg-outputs","key":"LWgLSNyUU4"}],"identifier":"hj2ytjc5q5tg","label":"Hj2ytjC5q5TG","html_id":"hj2ytjc5q5tg","key":"EY6Jmu8BK3"},{"type":"block","kind":"notebook-content","data":{"id":"t-iF2Yu7q9hZ"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Parity plot: actual vs predicted GWP","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gQM5Gt3BJp"}],"identifier":"parity-plot-actual-vs-predicted-gwp","label":"Parity plot: actual vs predicted GWP","html_id":"parity-plot-actual-vs-predicted-gwp","implicit":true,"key":"mYxhkZMyoU"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Plots the actual GWP against the predicted GWP for each case. Points on the dotted\ndiagonal are perfectly predicted; the further a point sits from the line, the larger\nits prediction error.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"UsXx3unCwU"}],"key":"OJAIqKczOJ"}],"identifier":"t-if2yu7q9hz","label":"t-iF2Yu7q9hZ","html_id":"t-if2yu7q9hz","key":"Ag6qYWXXl8"},{"type":"block","kind":"notebook-code","data":{"id":"zFVNd5q0q_rm"},"children":[{"type":"code","lang":"python","executable":true,"value":"# Predicted GWP from the fitted alpha, beta\nGWPpred = (X1**alpha * X2**beta) * GWPref\n\nfig, ax = plt.subplots(figsize=(6, 5))\n\n# Orange points\nax.scatter(GWPact, GWPpred, color='#E8703A', s=45, zorder=3)\n\n# Dotted trend line through origin (y = x reference)\nline_max = 2500\nax.plot([0, line_max], [0, line_max], color='#E8703A',\n        linestyle=':', linewidth=1.5, zorder=2)\n\n# Axes: linear, 0 to 2500, equal ticks\nax.set_xlim(0, 2500)\nax.set_ylim(0, 2500)\nax.set_xticks(range(0, 2501, 500))\nax.set_yticks(range(0, 2501, 500))\n\n# R2 annotation\nax.text(300, 2000, f\"R² = {round(r2, 4)}\", fontsize=12)\n\nax.set_xlabel(\"Actual GWP kgco$_2$-eq/kg$_{chem}$\", fontweight='bold')\nax.set_ylabel(\"Predicted GWP kgco$_2$-eq/kg$_{chem}$\", fontweight='bold')\nax.set_title(\"Dryer\", fontsize=14, fontweight='bold')\n\nplt.tight_layout()\nplt.show()","identifier":"zfvnd5q0q_rm-code","enumerator":"5","html_id":"zfvnd5q0q-rm-code","key":"qOBvPEPjev"},{"type":"outputs","id":"ortlxfkW1JfxZfXwBl073","children":[],"identifier":"zfvnd5q0q_rm-outputs","html_id":"zfvnd5q0q-rm-outputs","key":"zPIia3tSKB"}],"identifier":"zfvnd5q0q_rm","label":"zFVNd5q0q_rm","html_id":"zfvnd5q0q-rm","key":"GTalHkOvU3"}],"key":"CezgwhXnCz"},"references":{"cite":{"order":[],"data":{}}}}