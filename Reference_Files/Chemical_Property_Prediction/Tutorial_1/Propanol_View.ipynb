   "source": [
    "import py3Dmol\n",
    "\n",
    "with open(\"propanol_opt.xyz\") as f:\n",
    "    xyz = f.read()\n",
    "\n",
    "view = py3Dmol.view(width=500, height=400)\n",
    "view.addModel(xyz, \"xyz\")\n",
    "view.setStyle({\"stick\": {}, \"sphere\": {\"scale\": 0.3}})\n",
    "view.zoomTo()\n",
    "view.show()"
   ]
